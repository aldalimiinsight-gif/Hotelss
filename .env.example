# ============================================================
# HOTEL PRICE COMPARISON - API KEYS CONFIGURATION FILE
# ============================================================
# HOW TO USE THIS FILE:
# 1. Make a copy of this file and name it exactly: .env
# 2. Replace "your_key_here" with your actual API keys
# 3. Never share the .env file with anyone (it has your secret keys)
# ============================================================

# PORT: The number your backend server runs on (5000 is the default - leave as is)
PORT=5000

# ============================================================
# BOOKING PLATFORM API KEYS
# Sign up for each one to get real live prices:
# ============================================================

# BOOKING.COM AFFILIATE API
# Sign up at: https://www.booking.com/affiliate-program
# Then go to: https://developers.booking.com
BOOKING_API_KEY=your_booking_api_key_here
BOOKING_API_SECRET=your_booking_api_secret_here

# EXPEDIA PARTNER SOLUTIONS API
# Sign up at: https://expediapartnersolutions.com
EXPEDIA_API_KEY=your_expedia_api_key_here
EXPEDIA_API_SECRET=your_expedia_api_secret_here

# HOTELS.COM API (Uses Expedia Group infrastructure)
# Sign up at: https://rapidapi.com/apidojo/api/hotels4
HOTELS_COM_API_KEY=your_hotels_com_api_key_here

# AGODA API
# Sign up at: https://partners.agoda.com
AGODA_API_KEY=your_agoda_api_key_here
AGODA_SITE_ID=your_agoda_site_id_here

# KAYAK API
# Sign up at: https://www.kayak.com/labs
KAYAK_API_KEY=your_kayak_api_key_here

# TRIVAGO API
# Sign up at: https://partners.trivago.com
TRIVAGO_API_KEY=your_trivago_api_key_here

# PRICELINE API
# Sign up at: https://rapidapi.com/tipsters/api/priceline-com-provider
PRICELINE_API_KEY=your_priceline_api_key_here

# ============================================================
# NOTE: Until you add real API keys, the website uses
# realistic demo data so you can see how everything works.
# ============================================================
